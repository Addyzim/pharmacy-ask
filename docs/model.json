{"facts": {"sales_weekly": {"title": "Продажи по позициям", "where": ""}, "check_lines": {"title": "Строки чеков", "where": "check_lines.ВидОперации = 'Продажа'"}, "cheques": {"title": "Чеки", "where": "cheques.Вид_операции = 'Продажа'"}, "stock": {"title": "Остатки", "where": "stock.Дата = (SELECT MAX(Дата) FROM stock)"}, "refusals": {"title": "Отказы", "where": ""}, "sales_online": {"title": "Онлайн-заказы", "where": "sales_online.Статус <> 'Отменён'"}, "arrivals": {"title": "Приходы от поставщиков", "where": ""}, "movements": {"title": "Движения по сериям", "where": ""}, "sales_4m": {"title": "Продажи за 4 месяца", "where": ""}}, "dims": [{"id": "store", "title": "Аптека", "alias": "Аптека", "need": "store", "facts": {"sales_weekly": {"expr": "sales_weekly.\"Магазин\"", "join": null}, "check_lines": {"expr": "check_lines.\"Магазин\"", "join": null}, "cheques": {"expr": "cheques.\"Магазин\"", "join": null}, "stock": {"expr": "stock.\"Склад\"", "join": null}, "refusals": {"expr": "refusals.\"Магазин\"", "join": null}, "arrivals": {"expr": "arrivals.\"Склад\"", "join": null}, "movements": {"expr": "movements.\"Склад\"", "join": null}, "sales_4m": {"expr": "sales_4m.\"Магазин\"", "join": null}}}, {"id": "district", "title": "Район", "alias": "Район", "need": "store", "facts": {"sales_weekly": {"expr": "stores.Район", "join": "stores"}, "check_lines": {"expr": "stores.Район", "join": "stores"}, "cheques": {"expr": "stores.Район", "join": "stores"}, "stock": {"expr": "stores.Район", "join": "stores"}, "refusals": {"expr": "stores.Район", "join": "stores"}, "arrivals": {"expr": "stores.Район", "join": "stores"}, "movements": {"expr": "stores.Район", "join": "stores"}, "sales_4m": {"expr": "stores.Район", "join": "stores"}}}, {"id": "product", "title": "Номенклатура", "alias": "Номенклатура", "need": "product", "facts": {"sales_weekly": {"expr": "sales_weekly.\"Номенклатура\"", "join": null}, "check_lines": {"expr": "check_lines.\"Номенклатура\"", "join": null}, "stock": {"expr": "stock.\"Номенклатура\"", "join": null}, "refusals": {"expr": "refusals.\"Товар\"", "join": null}, "sales_online": {"expr": "sales_online.\"Номенклатура\"", "join": null}, "movements": {"expr": "movements.\"Номенклатура\"", "join": null}, "sales_4m": {"expr": "sales_4m.\"Номенклатура\"", "join": null}}}, {"id": "manufacturer", "title": "Производитель", "alias": "Производитель", "need": "product", "facts": {"sales_weekly": {"expr": "products.Производитель", "join": "products"}, "check_lines": {"expr": "products.Производитель", "join": "products"}, "stock": {"expr": "products.Производитель", "join": "products"}, "refusals": {"expr": "products.Производитель", "join": "products"}, "sales_online": {"expr": "products.Производитель", "join": "products"}, "movements": {"expr": "products.Производитель", "join": "products"}, "sales_4m": {"expr": "products.Производитель", "join": "products"}}}, {"id": "pharm_group", "title": "Фарм-группа", "alias": "Фарм_группа", "need": "product", "facts": {"sales_weekly": {"expr": "products.Фарм_группа", "join": "products"}, "check_lines": {"expr": "products.Фарм_группа", "join": "products"}, "stock": {"expr": "products.Фарм_группа", "join": "products"}, "refusals": {"expr": "products.Фарм_группа", "join": "products"}, "sales_online": {"expr": "products.Фарм_группа", "join": "products"}, "movements": {"expr": "products.Фарм_группа", "join": "products"}, "sales_4m": {"expr": "products.Фарм_группа", "join": "products"}}}, {"id": "rx", "title": "Рецептурный", "alias": "Рецептурный", "need": "product", "facts": {"sales_weekly": {"expr": "products.Рецептурный", "join": "products"}, "check_lines": {"expr": "products.Рецептурный", "join": "products"}, "stock": {"expr": "products.Рецептурный", "join": "products"}, "refusals": {"expr": "products.Рецептурный", "join": "products"}, "sales_online": {"expr": "products.Рецептурный", "join": "products"}, "movements": {"expr": "products.Рецептурный", "join": "products"}, "sales_4m": {"expr": "products.Рецептурный", "join": "products"}}}, {"id": "group", "title": "Товарная группа", "alias": "Товарная_группа", "need": "own:group", "facts": {"sales_weekly": {"expr": "sales_weekly.\"Группа\"", "join": null}, "stock": {"expr": "stock.\"Группа\"", "join": null}, "refusals": {"expr": "refusals.\"Группа\"", "join": null}, "sales_online": {"expr": "sales_online.\"Группа\"", "join": null}, "movements": {"expr": "movements.\"Группа\"", "join": null}, "sales_4m": {"expr": "sales_4m.\"Группа\"", "join": null}}}, {"id": "day", "title": "День", "alias": "День", "need": "date", "facts": {"sales_weekly": {"expr": "substr(sales_weekly.\"Дата\", 1, 10)", "join": null}, "check_lines": {"expr": "substr(check_lines.\"Дата\", 1, 10)", "join": null}, "cheques": {"expr": "substr(cheques.\"Дата\", 1, 10)", "join": null}, "stock": {"expr": "substr(stock.\"Дата\", 1, 10)", "join": null}, "refusals": {"expr": "substr(refusals.\"Дата\", 1, 10)", "join": null}, "sales_online": {"expr": "substr(sales_online.\"Дата\", 1, 10)", "join": null}, "arrivals": {"expr": "substr(arrivals.\"Дата\", 1, 10)", "join": null}, "sales_4m": {"expr": "substr(sales_4m.\"Дата\", 1, 10)", "join": null}}}, {"id": "month", "title": "Месяц", "alias": "Месяц", "need": "date", "facts": {"sales_weekly": {"expr": "substr(sales_weekly.\"Дата\", 1, 7)", "join": null}, "check_lines": {"expr": "substr(check_lines.\"Дата\", 1, 7)", "join": null}, "cheques": {"expr": "substr(cheques.\"Дата\", 1, 7)", "join": null}, "stock": {"expr": "substr(stock.\"Дата\", 1, 7)", "join": null}, "refusals": {"expr": "substr(refusals.\"Дата\", 1, 7)", "join": null}, "sales_online": {"expr": "substr(sales_online.\"Дата\", 1, 7)", "join": null}, "arrivals": {"expr": "substr(arrivals.\"Дата\", 1, 7)", "join": null}, "sales_4m": {"expr": "substr(sales_4m.\"Дата\", 1, 7)", "join": null}}}, {"id": "weekday", "title": "День недели", "alias": "День_недели", "need": "date", "facts": {"sales_weekly": {"expr": "CASE strftime('%w', sales_weekly.\"Дата\") WHEN '0' THEN 'Вс' WHEN '1' THEN 'Пн' WHEN '2' THEN 'Вт' WHEN '3' THEN 'Ср' WHEN '4' THEN 'Чт' WHEN '5' THEN 'Пт' ELSE 'Сб' END", "join": null}, "check_lines": {"expr": "CASE strftime('%w', check_lines.\"Дата\") WHEN '0' THEN 'Вс' WHEN '1' THEN 'Пн' WHEN '2' THEN 'Вт' WHEN '3' THEN 'Ср' WHEN '4' THEN 'Чт' WHEN '5' THEN 'Пт' ELSE 'Сб' END", "join": null}, "cheques": {"expr": "CASE strftime('%w', cheques.\"Дата\") WHEN '0' THEN 'Вс' WHEN '1' THEN 'Пн' WHEN '2' THEN 'Вт' WHEN '3' THEN 'Ср' WHEN '4' THEN 'Чт' WHEN '5' THEN 'Пт' ELSE 'Сб' END", "join": null}, "stock": {"expr": "CASE strftime('%w', stock.\"Дата\") WHEN '0' THEN 'Вс' WHEN '1' THEN 'Пн' WHEN '2' THEN 'Вт' WHEN '3' THEN 'Ср' WHEN '4' THEN 'Чт' WHEN '5' THEN 'Пт' ELSE 'Сб' END", "join": null}, "refusals": {"expr": "CASE strftime('%w', refusals.\"Дата\") WHEN '0' THEN 'Вс' WHEN '1' THEN 'Пн' WHEN '2' THEN 'Вт' WHEN '3' THEN 'Ср' WHEN '4' THEN 'Чт' WHEN '5' THEN 'Пт' ELSE 'Сб' END", "join": null}, "sales_online": {"expr": "CASE strftime('%w', sales_online.\"Дата\") WHEN '0' THEN 'Вс' WHEN '1' THEN 'Пн' WHEN '2' THEN 'Вт' WHEN '3' THEN 'Ср' WHEN '4' THEN 'Чт' WHEN '5' THEN 'Пт' ELSE 'Сб' END", "join": null}, "arrivals": {"expr": "CASE strftime('%w', arrivals.\"Дата\") WHEN '0' THEN 'Вс' WHEN '1' THEN 'Пн' WHEN '2' THEN 'Вт' WHEN '3' THEN 'Ср' WHEN '4' THEN 'Чт' WHEN '5' THEN 'Пт' ELSE 'Сб' END", "join": null}, "sales_4m": {"expr": "CASE strftime('%w', sales_4m.\"Дата\") WHEN '0' THEN 'Вс' WHEN '1' THEN 'Пн' WHEN '2' THEN 'Вт' WHEN '3' THEN 'Ср' WHEN '4' THEN 'Чт' WHEN '5' THEN 'Пт' ELSE 'Сб' END", "join": null}}}, {"id": "seller", "title": "Продавец", "alias": "Продавец", "need": "own:seller", "facts": {"check_lines": {"expr": "check_lines.\"Продавец\"", "join": null}}}, {"id": "gender", "title": "Пол покупателя", "alias": "Пол", "need": "own:gender", "facts": {"check_lines": {"expr": "check_lines.\"Пол\"", "join": null}}}, {"id": "partner", "title": "Поставщик прихода", "alias": "Поставщик", "need": "own:partner", "facts": {"arrivals": {"expr": "arrivals.\"Партнер\"", "join": null}}}, {"id": "supplier", "title": "Поставщик товара", "alias": "Поставщик_товара", "need": "own:supplier", "facts": {"sales_4m": {"expr": "sales_4m.\"Поставщик\"", "join": null}}}, {"id": "status", "title": "Статус заказа", "alias": "Статус", "need": "own:status", "facts": {"sales_online": {"expr": "sales_online.\"Статус\"", "join": null}}}], "metrics": [{"id": "revenue", "title": "Выручка", "alias": "Выручка", "fact": "sales_weekly", "agg": "ROUND(SUM(sales_weekly.СуммаСоСкидкой))", "formula": "Выручка = SUM(СуммаСоСкидкой) по sales_weekly"}, {"id": "revenue_gross", "title": "Выручка без скидки", "alias": "Выручка_без_скидки", "fact": "sales_weekly", "agg": "ROUND(SUM(sales_weekly.СуммаБезСкидки))", "formula": "Выручка без скидки = SUM(СуммаБезСкидки)"}, {"id": "discount", "title": "Скидка", "alias": "Скидка", "fact": "sales_weekly", "agg": "ROUND(SUM(sales_weekly.СуммаБезСкидки) - SUM(sales_weekly.СуммаСоСкидкой))", "formula": "Скидка = SUM(СуммаБезСкидки) − SUM(СуммаСоСкидкой)"}, {"id": "qty", "title": "Продано штук", "alias": "Штук", "fact": "sales_weekly", "agg": "SUM(sales_weekly.Количество)", "formula": "Штук = SUM(Количество)"}, {"id": "checks", "title": "Чеков", "alias": "Чеков", "fact": "cheques", "agg": "COUNT(*)", "formula": "Чеков = COUNT(*) по продажным чекам"}, {"id": "avg_check", "title": "Средний чек", "alias": "Средний_чек", "fact": "cheques", "agg": "ROUND(SUM(cheques.Сумма) / COUNT(*))", "formula": "Средний чек = SUM(Сумма) / COUNT(чеков)"}, {"id": "depth", "title": "Глубина чека", "alias": "Глубина_чека", "fact": "check_lines", "agg": "ROUND(1.0 * SUM(check_lines.Количество) / COUNT(DISTINCT check_lines.Номер), 2)", "formula": "Глубина = SUM(Количество) / COUNT(DISTINCT Номер)"}, {"id": "margin", "title": "Маржа, %", "alias": "Маржа_проц", "fact": "check_lines", "agg": "ROUND(100.0 * (SUM(check_lines.Выручка) - SUM(check_lines.СебестоимостьПродаж)) / SUM(check_lines.Выручка), 1)", "formula": "Маржа % = (Выручка − Себестоимость) / Выручка × 100"}, {"id": "cogs", "title": "Себестоимость", "alias": "Себестоимость", "fact": "check_lines", "agg": "ROUND(SUM(check_lines.СебестоимостьПродаж))", "formula": "Себестоимость = SUM(СебестоимостьПродаж)"}, {"id": "stock_sum", "title": "Остаток, сумма", "alias": "Остаток_сумма", "fact": "stock", "agg": "ROUND(SUM(stock.Сумма_остатка))", "formula": "Запас = SUM(Сумма_остатка) на последнюю дату среза"}, {"id": "stock_qty", "title": "Остаток, штук", "alias": "Остаток_штук", "fact": "stock", "agg": "SUM(stock.Количество_остаток)", "formula": "Остаток штук = SUM(Количество_остаток) на последнюю дату"}, {"id": "refusals", "title": "Отказы, штук", "alias": "Отказов", "fact": "refusals", "agg": "SUM(refusals.Количество)", "formula": "Отказы = SUM(Количество) по refusals"}, {"id": "online_revenue", "title": "Онлайн-выручка", "alias": "Онлайн_выручка", "fact": "sales_online", "agg": "ROUND(SUM(sales_online.Сумма_с_НДС))", "formula": "Онлайн = SUM(Сумма_с_НДС) по неотменённым заказам"}, {"id": "online_profit", "title": "Онлайн, валовая прибыль", "alias": "Валовая_прибыль", "fact": "sales_online", "agg": "ROUND(SUM(sales_online.Валовая_прибыль))", "formula": "Валовая прибыль = SUM(Валовая_прибыль)"}, {"id": "arrivals_sum", "title": "Приход, сумма", "alias": "Приход_сумма", "fact": "arrivals", "agg": "ROUND(SUM(arrivals.Сумма))", "formula": "Приход = SUM(Сумма) по arrivals"}, {"id": "markup", "title": "Наценка, %", "alias": "Наценка_проц", "fact": "movements", "agg": "ROUND(AVG(movements.Наценка_поступления), 1)", "formula": "Наценка = AVG(Наценка_поступления) по партиям"}, {"id": "sales_4m_sum", "title": "Продажи за 4 мес", "alias": "Продажи_4мес", "fact": "sales_4m", "agg": "ROUND(SUM(sales_4m.Сумма_продаж_со_скидкой))", "formula": "Продажи за 4 месяца = SUM(Сумма продаж со скидкой)"}], "joins": {"sales_weekly": {"stores": "LEFT JOIN stores ON stores.Магазин = sales_weekly.\"Магазин\"", "products": "LEFT JOIN products ON products.Наименование = sales_weekly.\"Номенклатура\""}, "check_lines": {"stores": "LEFT JOIN stores ON stores.Магазин = check_lines.\"Магазин\"", "products": "LEFT JOIN products ON products.Наименование = check_lines.\"Номенклатура\""}, "cheques": {"stores": "LEFT JOIN stores ON stores.Магазин = cheques.\"Магазин\""}, "stock": {"stores": "LEFT JOIN stores ON stores.Магазин = stock.\"Склад\"", "products": "LEFT JOIN products ON products.Наименование = stock.\"Номенклатура\""}, "refusals": {"stores": "LEFT JOIN stores ON stores.Магазин = refusals.\"Магазин\"", "products": "LEFT JOIN products ON products.Наименование = refusals.\"Товар\""}, "sales_online": {"products": "LEFT JOIN products ON products.Наименование = sales_online.\"Номенклатура\""}, "arrivals": {"stores": "LEFT JOIN stores ON stores.Магазин = arrivals.\"Склад\""}, "movements": {"stores": "LEFT JOIN stores ON stores.Магазин = movements.\"Склад\"", "products": "LEFT JOIN products ON products.Наименование = movements.\"Номенклатура\""}, "sales_4m": {"stores": "LEFT JOIN stores ON stores.Магазин = sales_4m.\"Магазин\"", "products": "LEFT JOIN products ON products.Наименование = sales_4m.\"Номенклатура\""}}}